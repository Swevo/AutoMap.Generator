<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>AutoMap.Generator.Templates</PackageId>
    <Title>AutoMap.Generator Demo Template</Title>
    <Authors>AutoMap.Generator contributors</Authors>
    <Description>dotnet new template that scaffolds a runnable console app demonstrating every AutoMap.Generator attribute ([Map], [MapFrom], [MapProperty], [MapWith], [MapWhen], [MapFormat], [MapDefault], [MapIgnore], [MapEnum], [MapConstructor], [TrimStrings], IMapFrom&lt;T&gt;, reverse mapping, projections, and partial method hooks).</Description>
    <PackageTags>dotnet-new;templates;automap;source-generator;mapping;automapper-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Swevo/AutoMap.Generator</RepositoryUrl>
    <PackageProjectUrl>https://swevo.github.io/AutoMap.Generator/</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*.cs" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\icon.png')" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
  </ItemGroup>

</Project>
